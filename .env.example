# Docker Compose: copie para .env (não versionado) e ajuste. Sem .env, valem os padrões abaixo.
POSTGRES_USER=contatos
POSTGRES_PASSWORD=contatos
POSTGRES_DB=contatos
API_PORT=3000
LOG_LEVEL=info
# Sem HTTPS local o prefixo __Host- não é aceito pelo navegador; em produção use __Host-sid
SESSION_COOKIE_NAME=sid

# Normaliza finais de linha para LF (Windows + CI Linux) — ADR-011
* text=auto eol=lf

# Scripts de shell e hooks precisam de LF mesmo no Windows
*.sh text eol=lf
.husky/* text eol=lf

# Fixtures de CSV: bytes exatos (BOM, CRLF e Windows-1252 fazem parte do teste)
apps/api/test/fixtures/*.csv -text

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfile: diff reduzido e merge pelo pnpm
pnpm-lock.yaml -diff linguist-generated=true merge=binary

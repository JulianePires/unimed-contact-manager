# Copie para .env (não versionado) e ajuste
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://contatos:contatos@localhost:5432/contatos
LOG_LEVEL=info
# true aplica as migrations antes do listen (Render free); localmente use pnpm db:migrate
MIGRATE_ON_BOOT=false
# Opcional: build do SPA servido em / (padrão: apps/web/dist; em dev o Vite serve o front)
# WEB_DIST_DIR=../web/dist

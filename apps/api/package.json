{
  "name": "@contatos/api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose -f ../../docker-compose.yml up -d --wait postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "devDependencies": {
    "@contatos/eslint-config": "workspace:*",
    "@contatos/tsconfig": "workspace:*",
    "@contatos/vitest-config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@contatos/contracts": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  }
}

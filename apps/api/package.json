{
  "name": "@contatos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@contatos/eslint-config": "workspace:*",
    "@contatos/tsconfig": "workspace:*",
    "@contatos/vitest-config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@contatos/contracts": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}

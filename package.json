{
  "name": "unimed-contact-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "biome format --write",
    "format:check": "biome format",
    "version:bump": "node scripts/bump-versions.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@contatos/eslint-config": "workspace:*",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.34.0 <11"
  }
}
